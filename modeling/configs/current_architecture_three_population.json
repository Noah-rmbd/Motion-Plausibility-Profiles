{
  "base_config": null,
  "reference_datasets": ["inat", "gowalla"],
  "matrix": {
    "model_id_prefix": "v6",
    "comparison_group": "current_architecture_three_population",
    "epochs": 15,
    "evaluation_datasets": ["inat", "gowalla", "synthetic"],
    "populations": [
      {
        "id": "combined",
        "datasets": ["inat", "gowalla"],
        "sampling_strategy": "all"
      },
      {
        "id": "inat",
        "datasets": ["inat"],
        "sampling_strategy": "all"
      },
      {
        "id": "gowalla",
        "datasets": ["gowalla"],
        "sampling_strategy": "all"
      }
    ],
    "feature_combinations": [
      {
        "id": "mpp_speed_accel_bearing_distance_time_speed",
        "features": [
          "speed_stationary",
          "speed_0_5",
          "speed_5_10",
          "speed_10_25",
          "speed_25_80",
          "speed_80_140",
          "speed_140_200",
          "speed_200_plus",
          "speed",
          "acceleration",
          "acceleration_valid",
          "elapsed_time",
          "distance",
          "bearing_sin",
          "bearing_cos",
          "bearing_valid"
        ]
      }
    ],
    "architectures": [
      {
        "id": "lstm_ae",
        "model_type": "lstm_autoencoder"
      },
      {
        "id": "t_lstm",
        "model_type": "t_lstm_autoencoder",
        "architecture": {
          "time_context": "elapsed_time",
          "time_unit": "hours",
          "time_aware_components": "encoder_and_decoder",
          "time_scale_seconds": 3600.0,
          "decay_function": "inverse_log"
        }
      },
      {
        "id": "lstm_seq2seq",
        "model_type": "lstm_seq2seq_autoencoder",
        "architecture": {
          "decoder": "teacher_forced_training_autoregressive_evaluation"
        }
      },
      {
        "id": "lagmm_paper",
        "model_type": "lagmm",
        "architecture": {
          "hidden_dim": 128,
          "num_layers": 1,
          "latent_dim": 1,
          "compression_dims": [64, 32, 16],
          "estimation_hidden_dim": 10,
          "estimation_dropout": 0.5,
          "representation": "one_dimensional_latent_relative_distance_cosine_similarity",
          "trajectory_score": "joint_gmm_energy",
          "implementation": "paper_joint_lagmm_v1"
        },
        "gmm": {
          "n_components": 4
        },
        "training": {
          "loss": "masked_mse"
        },
        "lagmm_objective": {
          "energy_weight": 0.1,
          "covariance_weight": 0.005,
          "covariance_epsilon": 0.000001
        }
      },
      {
        "id": "lstm_forecaster",
        "model_type": "lstm_forecaster",
        "features": [
          "speed_stationary",
          "speed_0_5",
          "speed_5_10",
          "speed_10_25",
          "speed_25_80",
          "speed_80_140",
          "speed_200_plus",
          "speed",
          "acceleration",
          "acceleration_valid",
          "bearing_sin",
          "bearing_cos",
          "bearing_valid",
          "distance",
          "elapsed_time"
        ],
        "architecture": {
          "hidden_dim": 32,
          "num_layers": 2,
          "dropout": 0.0,
          "forecast_horizon": 1
        }
      },
      {
        "id": "frechet_kernel",
        "model_type": "frechet_kernel",
        "architecture": {
          "landmarks": 64,
          "candidate_landmarks": 8,
          "max_sequence_length": 96,
          "gamma": 1.0,
          "beta": 1.0,
          "samples": 100,
          "diag_wgt": 1.0,
          "trajectory_score": "frechet_kernel_dissimilarity",
          "score": "one_minus_max_normalized_kernel",
          "use_pyfrk_extension": true
        },
        "training": {
          "max_trajectories": 5000
        },
        "evaluation": {
          "max_trajectories": null,
          "write_batch_size": 512
        }
      }
    ]
  }
}
